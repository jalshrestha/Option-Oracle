# ============================================================
# Option Oracle — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to git.
# ============================================================

# Database (self-hosted PostgreSQL via Docker)
DATABASE_URL=postgresql+asyncpg://oracle:<password>@localhost:5434/option_oracle

# Auth — generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string

# Docker Postgres credentials (used by docker-compose)
POSTGRES_USER=oracle
POSTGRES_PASSWORD=<strong-password-here>
POSTGRES_DB=option_oracle

# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL_LARGE=gpt-4o
OPENAI_MODEL_SMALL=gpt-4o-mini

# Gemini (required when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL_LARGE=gemini-2.0-flash
# GEMINI_MODEL_SMALL=gemini-2.0-flash-lite

# Optional — External APIs (leave blank to disable)
GEMINI_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
NEWS_API_KEY=
STOCKTWITS_ACCESS_TOKEN=
JIGSAWSTACK_API_KEY=

# Application
ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
