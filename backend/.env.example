# ============================================================
# Option Oracle — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to git.
# ============================================================

# Database (self-hosted PostgreSQL via Docker)
DATABASE_URL=postgresql+asyncpg://oracle@localhost:5434/option_oracle

# Auth — generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
ADMIN_API_TOKEN=

# Docker Postgres credentials (used by docker-compose)
POSTGRES_USER=oracle
POSTGRES_DB=option_oracle
DATABASE_URL_DOCKER=postgresql+asyncpg://oracle@postgres:5432/option_oracle
REDIS_URL=redis://localhost:6379/0

# LLM Provider: "openai", "gemini", or "deepseek"
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_LARGE=gpt-4o
OPENAI_MODEL_SMALL=gpt-4o-mini

# Gemini (required when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL_LARGE=gemini-2.0-flash
# GEMINI_MODEL_SMALL=gemini-2.0-flash-lite

# DeepSeek (required when LLM_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_LARGE=deepseek-v4-pro
# DEEPSEEK_MODEL_SMALL=deepseek-v4-flash

# Optional — External APIs (leave blank to disable)
GEMINI_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
NEWS_API_KEY=
STOCKTWITS_ACCESS_TOKEN=
JIGSAWSTACK_API_KEY=

# Application
ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Trading/system limits
MAX_CONCURRENT_ANALYSIS=10
DEFAULT_RISK_PROFILE=moderate
PAPER_TRADING_BALANCE=100000
LIVE_TRADING_ENABLED=false

# Optional ingestion layer
INGESTION_KAFKA_ENABLED=false
INGESTION_DASK_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=option-oracle
DASK_SCHEDULER_ADDRESS=tcp://dask-scheduler:8786
DASK_N_WORKERS=2
